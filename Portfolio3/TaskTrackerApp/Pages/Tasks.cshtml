@page
@model TaskTrackerApp.Pages.TasksModel
@{
    ViewData["Title"] = "Study Task Tracker";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/tasks.css" asp-append-version="true" />

<div class="tt-wrap">
    <header class="tt-header">
        <div class="tt-logo"><i class="bi bi-check2-all"></i></div>
        <div>
            <h1>Study Task Tracker</h1>
            <p>Plan it. Do it. Tick it off.</p>
        </div>
    </header>

    <section class="tt-stats">
        <div class="tt-stat">
            <i class="bi bi-list-task"></i>
            <div><span>@Model.Total</span><small>Total</small></div>
        </div>
        <div class="tt-stat">
            <i class="bi bi-hourglass-split"></i>
            <div><span>@Model.Pending</span><small>Pending</small></div>
        </div>
        <div class="tt-stat">
            <i class="bi bi-check-circle"></i>
            <div><span>@Model.Completed</span><small>Completed</small></div>
        </div>
    </section>

    <section class="tt-card">
        <div class="tt-progress-head">
            <span>Overall progress</span>
            <strong>@Model.Percent%</strong>
        </div>
        <div class="tt-progress"><div class="tt-bar" style="width:@(Model.Percent)%"></div></div>

        <form method="post" asp-page-handler="Add" asp-route-filter="@Model.Filter" class="tt-add">
            <input asp-for="Title" class="tt-input" placeholder="What do you need to get done?" maxlength="120" required />
            <select asp-for="Priority" class="tt-select">
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
            <button class="tt-btn-primary"><i class="bi bi-plus-lg"></i> Add</button>
        </form>

        <div class="tt-tabs">
            <a class="@(Model.Filter == "all" ? "active" : "")" asp-page="/Tasks" asp-route-filter="all">All</a>
            <a class="@(Model.Filter == "active" ? "active" : "")" asp-page="/Tasks" asp-route-filter="active">Active</a>
            <a class="@(Model.Filter == "done" ? "active" : "")" asp-page="/Tasks" asp-route-filter="done">Done</a>
        </div>

        @if (!Model.Tasks.Any())
        {
            <div class="tt-empty">
                <i class="bi bi-inbox"></i>
                <p>Nothing here yet. Add a task above to get started.</p>
            </div>
        }
        else
        {
            <ul class="tt-list">
                @foreach (var t in Model.Tasks)
                {
                    <li class="tt-item @(t.Done ? "is-done" : "")">
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@t.Id" asp-route-filter="@Model.Filter">
                            <button class="tt-check" title="@(t.Done ? "Mark as active" : "Mark as done")">
                                <i class="bi @(t.Done ? "bi-check-circle-fill" : "bi-circle")"></i>
                            </button>
                        </form>

                        <div class="tt-title">@t.Title</div>

                        <span class="tt-badge @t.Priority.ToLower()">@t.Priority</span>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" asp-route-filter="@Model.Filter">
                            <button class="tt-trash" title="Delete"><i class="bi bi-trash3"></i></button>
                        </form>
                    </li>
                }
            </ul>
        }

        @if (Model.Completed > 0)
        {
            <form method="post" asp-page-handler="ClearDone" asp-route-filter="@Model.Filter" class="tt-footer">
                <button class="tt-link"><i class="bi bi-eraser"></i> Clear completed</button>
            </form>
        }
    </section>
</div>